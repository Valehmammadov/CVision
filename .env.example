# ─────────────────────────────────────────────────────────────────────────────
# CVision environment variables
#
# 1. Copy this file to `.env.local`   (cp .env.example .env.local)
# 2. Fill in the values you need.
# 3. NEVER commit `.env.local` — it is ignored by .gitignore.
#
# All variables are OPTIONAL. Without any of them the app runs fully,
# using the built-in rule-based screening engine.
# These are read on the server only (never sent to the browser).
# Do not prefix them with NEXT_PUBLIC_ — that would expose them publicly.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key — enables AI-assisted CV analysis.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=

# GitHub personal access token for skill verification (no scopes needed).
# Raises GitHub's limit from 60 to 5,000 API requests per hour.
# Create one at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# ── Advanced / testing only (leave empty in normal use) ──────────────────────
# GEMINI_API_BASE_URL=
# GITHUB_API_BASE_URL=
# GITHUB_RAW_BASE_URL=
